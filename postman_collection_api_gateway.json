                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Requires a valid user and token from Auth steps - usually run consecutively",
                                    "const randomId = Math.floor(Math.random() * 1000000);",
                                    "pm.collectionVariables.set(\"org_name\", `Gateway Org ${randomId}`);",
                                    "pm.collectionVariables.set(\"org_slug\", `gatewayorg${randomId}`);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "var jsonData = pm.response.json();",
                                    "var orgId = null;",
                                    "if (jsonData.data && jsonData.data.id) orgId = jsonData.data.id;",
                                    "if (!orgId && jsonData.data && jsonData.data.org && jsonData.data.org.id) orgId = jsonData.data.org.id;",
                                    "if (!orgId && jsonData.id) orgId = jsonData.id;",
                                    "",
                                    "if (orgId) {",
                                    "    pm.collectionVariables.set(\"org_id\", orgId);",
                                    "    console.log(\"Created Org via Gateway:\", orgId);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
