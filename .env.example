# ==========================================
# Microservices Platform - Environment Variables
# ==========================================
# Only non-sensitive defaults are committed here.
# Copy to .env for local development.

# --- Global Environment ---
ENV=development
LOG_LEVEL=debug
REGION=us-east-1

# --- Database (PostgreSQL) ---
# Format: postgres://user:password@host:port/dbname
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# --- Cache & Messaging (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Object Storage (MinIO) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_REGION=us-east-1

# --- Auth & Security ---
# Generate secure random strings for production!
JWT_SECRET=dev-secret-key-change-me-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
API_KEY_SALT=dev-salt-change-me

# --- Service Ports (Internal) ---
PORT_GATEWAY=3000
PORT_AUTH=8080
PORT_ORG=8081
PORT_NOTIFY=8082
PORT_BILLING=8083
PORT_FILE=8084
PORT_AUDIT=8085
PORT_ANALYTICS=8086

# --- External APIs (Placeholders) ---
STRIPE_SECRET_KEY=sk_test_...
SENDGRID_API_KEY=SG....
TWILIO_SID=AC...
TWILIO_TOKEN=...
