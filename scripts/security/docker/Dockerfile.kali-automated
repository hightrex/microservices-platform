# scripts/security/docker/Dockerfile.kali-automated
# NOTE: kali-rolling is a rolling release; pinning to a quarterly tag.
FROM docker.io/kalilinux/kali-rolling:2025.1c

# Install required tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Reconnaissance
    nmap \
    masscan \
    fierce \
    # Web scanning
    nikto \
    dirb \
    whatweb \
    wapiti \
    # Vulnerability scanning
    nuclei \
    # Injection testing
    sqlmap \
    xsser \
    commix \
    # API testing
    ffuf \
    wfuzz \
    # SSL/TLS testing
    testssl.sh \
    sslscan \
    # Reporting
    python3 \
    python3-pip \
    jq \
    # Utilities
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for reporting
RUN pip3 install --no-cache-dir --break-system-packages \
    requests \
    jinja2 \
    PyYAML \
    python-dotenv \
    tabulate \
    colorama

# Install additional tools from GitHub
RUN git clone --depth 1 https://github.com/projectdiscovery/nuclei-templates.git /opt/nuclei-templates

# Create working directories
RUN mkdir -p /pentest/{config,modules,reports,results,utils}

WORKDIR /pentest

# Copy automation scripts
COPY kali/ /pentest/

# Make all scripts and utilities executable
RUN chmod +x /pentest/automated-scan.sh \
    && chmod +x /pentest/modules/*.sh \
    && chmod +x /pentest/utils/*.sh 2>/dev/null || true

# Default: keep container alive so exec can drive it
CMD ["sleep", "infinity"]
