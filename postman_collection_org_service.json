{
  "info": {
    "_postman_id": "organization-service-collection",
    "name": "Organization Service API",
    "description": "Collection for testing Organization Service endpoints with automated variable handling. Assumes Auth Service issues JWTs and Organization Service enforces X-Tenant-ID + Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Infrastructure",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Service is UP\", function () {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bootstrap (Auth + Tenant)",
      "item": [
        {
          "name": "Generate Test Identity + Tenant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate user identities + tenant once per run",
                  "const randomId = Math.floor(Math.random() * 1000000);",
                  "pm.collectionVariables.set(\"email\", `orgtestuser${randomId}@example.com`);",
                  "pm.collectionVariables.set(\"invitee_email\", `invitee${randomId}@example.com`);",
                  "pm.collectionVariables.set(\"password\", \"Password123!\");",
                  "",
                  "let tenantId = pm.collectionVariables.get(\"tenant_id\");",
                  "if (!tenantId) {",
                  "  tenantId = pm.variables.replaceIn(\"{{$guid}}\");",
                  "  pm.collectionVariables.set(\"tenant_id\", tenantId);",
                  "}",
                  "",
                  "// Org defaults",
                  "pm.collectionVariables.set(\"org_name\", `Acme Org ${randomId}`);",
                  "pm.collectionVariables.set(\"org_slug\", `acmeorg${randomId}`.toLowerCase());",
                  "pm.collectionVariables.set(\"module_name\", \"notifications\");",
                  "pm.collectionVariables.set(\"new_plan\", \"business\");",
                  "pm.collectionVariables.set(\"dept_name\", `Engineering-${randomId}`);",
                  "pm.collectionVariables.set(\"dept_description\", \"Engineering department\");",
                  "",
                  "// Initialize variables to avoid literal {{var}} sending before they are set",
                  "pm.collectionVariables.set(\"user_id\", \"\");",
                  "pm.collectionVariables.set(\"roles\", \"\");",
                  "pm.collectionVariables.set(\"access_token\", \"\");",
                  "pm.collectionVariables.set(\"org_id\", \"\");",
                  "pm.collectionVariables.set(\"dept_id\", \"\");",
                  "pm.collectionVariables.set(\"invitee_user_id\", \"\");",
                  "",
                  "console.log(\"Generated Owner:\", pm.collectionVariables.get(\"email\"));",
                  "console.log(\"Generated Invitee:\", pm.collectionVariables.get(\"invitee_email\"));",
                  "console.log(\"Generated Tenant:\", tenantId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Auth Register (Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"first_name\": \"Org\",\n  \"last_name\": \"Owner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_base_url}}/api/v1/auth/register",
              "host": [
                "{{auth_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Auth Login (Owner) -> Set Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "  pm.collectionVariables.set(\"access_token\", jsonData.data.access_token);",
                  "  pm.collectionVariables.set(\"refresh_token\", jsonData.data.refresh_token);",
                  "  if (jsonData.data.user) {",
                  "    pm.collectionVariables.set(\"user_id\", jsonData.data.user.id);",
                  "    if (jsonData.data.user.roles && Array.isArray(jsonData.data.user.roles)) {",
                  "      pm.collectionVariables.set(\"roles\", jsonData.data.user.roles.join(\",\"));",
                  "    } else {",
                  "      pm.collectionVariables.set(\"roles\", \"\");",
                  "    }",
                  "  }",
                  "  console.log(\"Logged in. Token and identity headers set.\");",
                  "}",
                  "",
                  "pm.test(\"Access token set\", function () {",
                  "  pm.expect(pm.collectionVariables.get(\"access_token\")).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{auth_base_url}}/api/v1/auth/login",
              "host": [
                "{{auth_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Auth Register (Invitee)",
