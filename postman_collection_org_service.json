    {
      "name": "Organizations",
      "item": [
        {
          "name": "Create Organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "// Accept common response shapes",
                  "var orgId = null;",
                  "if (jsonData.data && jsonData.data.id) orgId = jsonData.data.id;",
                  "if (!orgId && jsonData.data && jsonData.data.org && jsonData.data.org.id) orgId = jsonData.data.org.id;",
                  "if (!orgId && jsonData.id) orgId = jsonData.id;",
                  "",
                  "pm.test(\"Organization ID captured\", function () {",
                  "  pm.expect(orgId).to.not.be.null;",
                  "});",
                  "if (orgId) {",
                  "  pm.collectionVariables.set(\"org_id\", orgId);",
                  "  pm.collectionVariables.set(\"tenant_id\", orgId);",
                  "  pm.collectionVariables.set(\"roles\", \"org_owner,org_admin\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
