                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "  pm.collectionVariables.set(\"invitee_user_id\", jsonData.data.id);",
                  "  console.log(\"Invitee ID captured:\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "{{tenant_id}}",
                "type": "text"
              }
