# File Service — Multi-stage Rust build
FROM rust:1.93-slim-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY libs/rust/ /build/libs/rust/
COPY services/file-service/ /build/services/file-service/

WORKDIR /build/services/file-service
RUN cargo build --release

# Runtime
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser

WORKDIR /app

COPY --from=builder /build/services/file-service/target/release/file-service /app/file-service
COPY services/file-service/config/ /app/config/
COPY services/file-service/migrations/ /app/migrations/

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8084

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8084/health || exit 1

ENTRYPOINT ["/app/file-service"]
