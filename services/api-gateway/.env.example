# API Gateway Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Upstream Services (internal compose DNS names)
AUTH_BASE_URL=http://platform-auth-service:8080
ORG_BASE_URL=http://platform-organization-service:8081

# Redis
REDIS_URL=redis://platform-redis:6379
REDIS_PASSWORD=devredispass
REDIS_DB=2

# CORS — explicit allowlist, never "*"
CORS_ORIGINS=http://localhost:3001

# JWT Validation
JWT_SECRET=dev-secret-change-in-production-minimum-32-chars!
JWT_ISSUER=auth-service

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Request Body Limit (bytes)
BODY_LIMIT_BYTES=1048576

# Circuit Breaker
CB_TIMEOUT=10000
CB_ERROR_THRESHOLD=50
CB_RESET_TIMEOUT=30000

# Module Cache TTL (seconds)
MODULE_CACHE_TTL_SECONDS=300
