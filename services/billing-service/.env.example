# Billing Service Environment Variables
# Copy to .env for local development

# Server
APP_SERVER__HOST=0.0.0.0
APP_SERVER__PORT=8083

# Database
APP_DATABASE__HOST=localhost
APP_DATABASE__PORT=5432
APP_DATABASE__USER=billing_user
APP_DATABASE__PASSWORD=billing_password
APP_DATABASE__DATABASE=billing_db
APP_DATABASE__SSL_MODE=disable
APP_DATABASE__MAX_CONNECTIONS=10
APP_DATABASE__MIN_CONNECTIONS=2

# Redis
APP_REDIS__HOST=localhost
APP_REDIS__PORT=6379
APP_REDIS__PASSWORD=
APP_REDIS__DB=0

# Stripe (use test mode keys for development)
APP_STRIPE__SECRET_KEY=sk_test_your_test_key_here
APP_STRIPE__WEBHOOK_SECRET=whsec_your_webhook_secret_here
APP_STRIPE__PUBLISHABLE_KEY=pk_test_your_publishable_key_here
APP_STRIPE__TEST_MODE=true

# Logging
APP_LOGGER__LEVEL=debug
APP_LOGGER__ENVIRONMENT=local

# Invoice
APP_INVOICE__DUE_DAYS=30
APP_INVOICE__LATE_FEE_PERCENTAGE=1.5
