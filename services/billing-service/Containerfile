# Billing Service — Multi-stage Rust build
# Stage 1: Build
FROM rust:1.93-slim-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace dependencies first for better caching
COPY libs/rust/ /build/libs/rust/

# Copy service source
COPY services/billing-service/ /build/services/billing-service/

WORKDIR /build/services/billing-service

# Build release binary
RUN cargo build --release

# Stage 2: Runtime
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser

WORKDIR /app

# Copy binary
COPY --from=builder /build/services/billing-service/target/release/billing-service /app/billing-service

# Copy config
COPY services/billing-service/config/ /app/config/
COPY services/billing-service/migrations/ /app/migrations/

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8083

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8083/health || exit 1

ENTRYPOINT ["/app/billing-service"]
