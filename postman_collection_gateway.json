                                    "pm.test('Contains starter plan', () => pm.expect(names).to.include('starter'));",
                                    "pm.test('Contains business plan', () => pm.expect(names).to.include('business'));",
                                    "pm.test('Contains enterprise plan', () => pm.expect(names).to.include('enterprise'));",
                                    "pm.test('Plan has expected fields', () => {",
                                    "    const plan = body.data[0];",
                                    "    pm.expect(plan).to.have.property('max_users');",
                                    "    pm.expect(plan).to.have.property('max_storage_bytes');",
