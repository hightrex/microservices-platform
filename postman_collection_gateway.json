                                    "    pm.expect(body.data.refresh_token).to.be.a('string').and.not.empty;",
                                    "    pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                                    "});",
                                    "pm.test('token_type is Bearer', () => pm.expect(body.data.token_type).to.eql('Bearer'));",
                                    "pm.test('expires_in is positive number', () => pm.expect(body.data.expires_in).to.be.above(0));",
