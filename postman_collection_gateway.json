        {
            "name": "03 — Auth Flow (Register → Login)",
            "item": [
                {
                    "name": "Register Primary User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 201 or 200', () => {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                                    "});",
                                    "const body = pm.response.json();",
                                    "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                                    "pm.test('Returns user ID', () => {",
                                    "    pm.expect(body.data.id).to.be.a('string').and.not.empty;",
                                    "    pm.collectionVariables.set('user_id', body.data.id);",
                                    "});",
                                    "pm.test('Returns correct email', () => {",
                                    "    pm.expect(body.data.email).to.eql(pm.collectionVariables.get('test_email'));",
                                    "});",
                                    "pm.test('Status is active', () => pm.expect(body.data.status).to.eql('active'));",
                                    "pm.test('Has created_at timestamp', () => pm.expect(body.data.created_at).to.be.a('string'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "X-Tenant-ID", "value": "{{tenant_id}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\",\n    \"first_name\": \"Newman\",\n    \"last_name\": \"TestUser\"\n}"
                        },
                        "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"] }
                    }
