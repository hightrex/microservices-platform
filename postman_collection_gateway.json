        {
            "name": "04 — User Management (Authenticated)",
            "item": [
                {
                    "name": "List Users (paginated)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.test('success is true', () => pm.expect(body.success).to.be.true);",
                                    "pm.test('Returns items array', () => pm.expect(body.data.items).to.be.an('array'));",
                                    "pm.test('Has total_count', () => pm.expect(body.data.total_count).to.be.a('number'));",
                                    "pm.test('Has page', () => pm.expect(body.data.page).to.be.a('number'));",
                                    "pm.test('Has page_size', () => pm.expect(body.data.page_size).to.be.a('number'));",
                                    "pm.test('Has total_pages', () => pm.expect(body.data.total_pages).to.be.a('number'));",
                                    "pm.test('Our user is in the list', () => {",
                                    "    const found = body.data.items.find(u => u.id === pm.collectionVariables.get('user_id'));",
                                    "    pm.expect(found).to.not.be.undefined;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{access_token}}" }
                        ],
                        "url": { "raw": "{{base_url}}/api/v1/users?page=1&page_size=20", "host": ["{{base_url}}"], "path": ["api","v1","users"], "query": [{"key":"page","value":"1"},{"key":"page_size","value":"20"}] }
